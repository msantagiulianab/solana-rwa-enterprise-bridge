# Docker Compose (Local PostgreSQL container defaults)
POSTGRES_DB=rwa_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Spring Boot Datasource (Neon / External Postgres or Local Docker)
# Example Neon JDBC URL: jdbc:postgresql://<host>/<database>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-your-database-host.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password_here

# Solana Devnet RPC
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_DEVNET_PRIVATE_KEY=your_base58_private_key_here

# API security (mutating-route gate)
SECURITY_API_KEY=your_shared_api_key_here
